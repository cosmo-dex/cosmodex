# App Base URL (Production or Local)
NEXT_PUBLIC_APP_URL="https://cosmodex.in"

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://cosmodex:cosmodex@localhost:5433/cosmodex"
DIRECT_URL="postgresql://cosmodex:cosmodex@localhost:5433/cosmodex"

# Redis Instance (Cache & Queue Tracking)
REDIS_URL="redis://localhost:6379"

# Next Auth & Session Security (Must match cosmodex-admin SESSION_SECRET for shared session verification)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-at-least-32-char-random-secret"

# JWT Secret for Battle Arena WebSockets (MUST MATCH backend JWT_SECRET)
JWT_SECRET="replace-with-at-least-32-char-shared-jwt-secret"

# Battle Arena Backend & WebSocket Gateway
# Local development:
BATTLE_ARENA_URL="http://localhost:3001"
NEXT_PUBLIC_BATTLE_ARENA_URL="http://localhost:3001"
NEXT_PUBLIC_BATTLE_ARENA_WS_URL="ws://localhost:3001"
# Production examples:
# NEXT_PUBLIC_BATTLE_ARENA_URL="https://battle-arena.cosmodex.in"
# NEXT_PUBLIC_BATTLE_ARENA_WS_URL="wss://battle-arena.cosmodex.in"

# Event Administration Backend (cosmodex-admin)
# Local development:
EVENT_BACKEND_URL="http://localhost:3002"
NEXT_PUBLIC_EVENT_BACKEND_URL="http://localhost:3002"
# Production examples:
# EVENT_BACKEND_URL="https://admin.cosmodex.in"
# NEXT_PUBLIC_EVENT_BACKEND_URL="https://admin.cosmodex.in"

# OAuth Authentication (Optional / Social Logins)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AI Chatbot Assistant (Optional)
NEXT_PUBLIC_CHATBOT_API_URL="http://localhost:5000"

# Razorpay Payments (Optional)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret_here"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

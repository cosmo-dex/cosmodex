# App Base URL (Production or Local)
NEXT_PUBLIC_APP_URL="https://cosmodex.in"

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:YourStrongLocalPassword2024@localhost:5432/postgres"

# Redis Database
REDIS_URL=redis://localhost:6379

# Next Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-me-with-at-least-32-char-random-string

# GitHub OAuth App
AUTH_GITHUB_ID=your-github-client-id
AUTH_GITHUB_SECRET=your-github-client-secret

# Google OAuth App
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

NEXT_PUBLIC_BATTLE_ARENA_URL=https://battle-arena-golang.onrender.com
BATTLE_ARENA_URL=http://localhost:3001

NEXT_PUBLIC_EVENT_BACKEND_URL=https://event-backend-golang.onrender.com
EVENT_BACKEND_URL=http://localhost:3002

NEXT_PUBLIC_CHATBOT_API_URL=http://localhost:5000

# Razorpay Subscriptions
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret_here"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
